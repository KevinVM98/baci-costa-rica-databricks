{
  "datasets": [
    {
      "name": "2b07dd61",
      "displayName": "resumen_anual_cr",
      "queryLines": [
        "WITH base AS (\r\n",
        "    SELECT\r\n",
        "        anio,\r\n",
        "        total_importado_usd,\r\n",
        "        CASE\r\n",
        "            WHEN participacion_principal_pct >= 90\r\n",
        "             AND total_importado_usd >= 1000000\r\n",
        "            THEN 1\r\n",
        "            ELSE 0\r\n",
        "        END AS seleccionado\r\n",
        "    FROM workspace.baci.concentracion_importaciones_cr\r\n",
        "    WHERE anio BETWEEN 2016 AND 2023\r\n",
        "      AND clasificacion = 'HS92'\r\n",
        "      AND version_baci = '202501'\r\n",
        "),\r\n",
        "resumen AS (\r\n",
        "    SELECT\r\n",
        "        anio,\r\n",
        "        COUNT(*) AS productos_importados,\r\n",
        "        SUM(total_importado_usd) AS importaciones_totales_usd,\r\n",
        "        SUM(seleccionado) AS productos_seleccionados,\r\n",
        "        SUM(\r\n",
        "            CASE\r\n",
        "                WHEN seleccionado = 1 THEN total_importado_usd\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ) AS importaciones_seleccionadas_usd\r\n",
        "    FROM base\r\n",
        "    GROUP BY anio\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    anio,\r\n",
        "    productos_importados,\r\n",
        "    ROUND(importaciones_totales_usd, 2)\r\n",
        "        AS importaciones_totales_usd,\r\n",
        "    productos_seleccionados,\r\n",
        "    ROUND(importaciones_seleccionadas_usd, 2)\r\n",
        "        AS importaciones_seleccionadas_usd,\r\n",
        "    CASE\r\n",
        "        WHEN importaciones_totales_usd > 0\r\n",
        "        THEN ROUND(\r\n",
        "            100.0 * importaciones_seleccionadas_usd\r\n",
        "            / importaciones_totales_usd,\r\n",
        "            2\r\n",
        "        )\r\n",
        "    END AS participacion_valor_seleccionado_pct\r\n",
        "FROM resumen\r\n",
        "ORDER BY anio;"
      ]
    },
    {
      "name": "ad0d9d1a",
      "displayName": "productos_seleccionados_cr",
      "queryLines": [
        "SELECT\r\n",
        "    anio,\r\n",
        "    codigo_producto,\r\n",
        "    producto,\r\n",
        "    exportador_principal,\r\n",
        "    ROUND(participacion_principal_pct, 2)\r\n",
        "        AS participacion_principal_pct,\r\n",
        "    total_importado_usd,\r\n",
        "    paises_exportadores\r\n",
        "FROM workspace.baci.concentracion_importaciones_cr\r\n",
        "WHERE anio BETWEEN 2016 AND 2023\r\n",
        "  AND clasificacion = 'HS92'\r\n",
        "  AND version_baci = '202501'\r\n",
        "  AND participacion_principal_pct >= 90\r\n",
        "  AND total_importado_usd >= 1000000\r\n",
        "ORDER BY\r\n",
        "    anio DESC,\r\n",
        "    total_importado_usd DESC,\r\n",
        "    codigo_producto;"
      ]
    },
    {
      "name": "0c9903e0",
      "displayName": "alternativas_cr",
      "queryLines": [
        "SELECT\r\n",
        "    anio,\r\n",
        "    codigo_producto,\r\n",
        "    producto,\r\n",
        "    exportador_principal,\r\n",
        "    posicion_alternativa,\r\n",
        "    exportador_alternativo,\r\n",
        "    ROUND(exportaciones_mundiales_usd, 2)\r\n",
        "        AS exportaciones_mundiales_usd,\r\n",
        "    destinos,\r\n",
        "    ROUND(exportaciones_a_cr_usd, 2)\r\n",
        "        AS exportaciones_a_cr_usd\r\n",
        "FROM workspace.baci.alternativas_importaciones_cr\r\n",
        "WHERE anio BETWEEN 2016 AND 2023\r\n",
        "  AND clasificacion = 'HS92'\r\n",
        "  AND version_baci = '202501'\r\n",
        "ORDER BY\r\n",
        "    anio DESC,\r\n",
        "    codigo_producto,\r\n",
        "    posicion_alternativa;"
      ]
    }
  ],
